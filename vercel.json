{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api",
      "dest": "/api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/src/(.*)",
      "dest": "/src/$1"
    },
    {
      "src": "/overview",
      "dest": "/html/home.html"
    },
    {
      "src": "/home",
      "dest": "/html/home.html"
    },
    {
      "src": "/explore",
      "dest": "/html/explore.html"
    },
    {
      "src": "/circuits",
      "dest": "/html/circuits.html"
    },
    {
      "src": "/map",
      "dest": "/html/map.html"
    },
    {
      "src": "/planner",
      "dest": "/html/planner.html"
    },
    {
      "src": "/ai",
      "dest": "/html/ai.html"
    },
    {
      "src": "/responsible",
      "dest": "/html/responsible.html"
    },
    {
      "src": "/culture",
      "dest": "/html/culture.html"
    },
    {
      "src": "/food",
      "dest": "/html/food.html"
    },
    {
      "src": "/login",
      "dest": "/html/login.html"
    },
    {
      "src": "/register",
      "dest": "/html/register.html"
    },
    {
      "src": "/profile",
      "dest": "/html/profile.html"
    },
    {
      "src": "/codebreakerz",
      "dest": "/html/CodeBreakerz.html"
    },
    {
      "src": "/team",
      "dest": "/html/CodeBreakerz.html"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/html/index(?:\\.html)?",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/html/([^./]+)(?:\\.html)?",
      "dest": "/html/$1.html"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/html/$1.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}